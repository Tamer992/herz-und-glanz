---
import Textseite from '../components/Textseite.astro';
import { site } from '../site.config';
// Rechtstexte bleiben aus den Suchmaschinen heraus (indexieren={false}), gefunden werden sollen die Inhaltsseiten.
// Angaben stehen in site.config.ts unter „recht“. Leere Felder erscheinen nicht.
const r = site.recht;
---
<Textseite
  titel={`Impressum | ${site.name}`}
  beschreibung={`Impressum von ${site.name}, ${site.adresse.ort}.`}
  ueberschrift="Impressum"
  etikett="Rechtliches"
  indexieren={false}
>
  <h2>Angaben gemäß § 5 DDG</h2>
  <address>
    {site.name}<br />
    {site.inhaberTitel}: {site.inhaberVoll}<br />
    {site.adresse.strasse}<br />
    {site.adresse.plz} {site.adresse.ort}
  </address>
  {r.rechtsform && <p>Rechtsform: {r.rechtsform}. Vertretungsberechtigt sind {site.inhaberVoll}.</p>}

  <h2>Kontakt</h2>
  <p>
    Telefon {site.telefonName}: <a href={`tel:${site.telefonLink}`}><span class="nummer">{site.telefon}</span></a><br />
    {site.telefon2 && <>Telefon {site.telefon2Name}: <a href={`tel:${site.telefon2Link}`}><span class="nummer">{site.telefon2}</span></a><br /></>}
    E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>

  {(r.ustId || r.wirtschaftsId) && (
    <>
      <h2>Steuerliche Angaben</h2>
      <p>
        {r.ustId && <>Umsatzsteuer-Identifikationsnummer nach § 27a Umsatzsteuergesetz: {r.ustId}<br /></>}
        {r.wirtschaftsId && <>Wirtschafts-Identifikationsnummer: {r.wirtschaftsId}</>}
      </p>
    </>
  )}

  {site.anerkennung && r.aufsicht.name && (
    <>
      <h2>Anerkennung und zuständige Behörde</h2>
      <p>
        Unsere Alltagsbegleitung, Hauswirtschaft und Trauerbegleitung sind als Angebot zur Unterstützung im Alltag
        nach § 45a SGB XI in Hessen anerkannt. Zuständige Behörde:
      </p>
      <address>
        {r.aufsicht.name}<br />
        {r.aufsicht.adresse}
      </address>
    </>
  )}

  {r.haftpflicht.name && (
    <>
      <h2>Betriebshaftpflichtversicherung</h2>
      <address>
        {r.haftpflicht.name}<br />
        {r.haftpflicht.adresse}
      </address>
      <p>Geltungsbereich: {r.haftpflicht.gebiet}</p>
    </>
  )}

  <h2>Verbraucherstreitbeilegung</h2>
  <p>
    Wir nehmen nicht an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teil und sind dazu auch
    nicht verpflichtet. Wenn etwas nicht passt, rufen Sie uns bitte an. Wir finden gemeinsam eine Lösung.
  </p>

  <h2>Inhalte dieser Webseite</h2>
  <p>
    Texte, Gestaltung und Logo dieser Webseite sind urheberrechtlich geschützt. Die Fotos stammen von Unsplash und
    werden nach der dortigen Lizenz verwendet.
  </p>
</Textseite>
