# Einstellungen für den Webserver bei IONOS (Apache). Auf GitHub Pages wird diese Datei nicht beachtet.

# Eigene Fehlerseite statt der Standardmeldung des Servers
ErrorDocument 404 /404.html

# Zeichensatz mitsenden, damit Umlaute überall stimmen
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .css .js .svg .xml .txt
</IfModule>

RewriteEngine On
# Immer verschlüsselt und immer ohne www, damit jede Seite nur eine Adresse hat
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://herzglanz-service.de%{REQUEST_URI} [R=301,L]
# Merker für die Kopfzeilen weiter unten: verschlüsselter Abruf, Datei mit Prüfsumme im Namen
RewriteCond %{HTTPS} =on
RewriteRule ^ - [E=SICHER:1]
RewriteRule ^_astro/ - [E=FEST:1]

# Texte komprimiert ausliefern (HTML war es schon, jetzt auch CSS, Skripte und SVG)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# Wie lange Browser Dateien behalten dürfen: Seiten gar nicht, Bilder, Schriften und Stile einen Monat
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Dateien unter /_astro/ tragen eine Prüfsumme im Namen und ändern sich nie: ein Jahr behalten
  Header set Cache-Control "public, max-age=31536000, immutable" env=FEST
  # Sicherheit: nur verschlüsselt, Dateityp nicht raten, Seite nicht in fremde Rahmen, sparsame Herkunftsangabe
  Header always set Strict-Transport-Security "max-age=31536000" env=SICHER
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
